<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Add ROM Folder…</attribute>
        <attribute name="action">win.add-folder</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Rescan Library</attribute>
        <attribute name="action">win.rescan</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Preferences</attribute>
        <attribute name="action">win.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">About Dice</attribute>
        <attribute name="action">app.about</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Quit</attribute>
        <attribute name="action">app.quit</attribute>
      </item>
    </section>
  </menu>

  <menu id="sort_menu">
    <section>
      <attribute name="label" translatable="yes">Sort by</attribute>
      <item>
        <attribute name="label" translatable="yes">Title</attribute>
        <attribute name="action">win.sort</attribute>
        <attribute name="target">title</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Platform</attribute>
        <attribute name="action">win.sort</attribute>
        <attribute name="target">platform</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Recently Played</attribute>
        <attribute name="action">win.sort</attribute>
        <attribute name="target">played</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Recently Added</attribute>
        <attribute name="action">win.sort</attribute>
        <attribute name="target">added</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Size</attribute>
        <attribute name="action">win.sort</attribute>
        <attribute name="target">size</attribute>
      </item>
    </section>
  </menu>

  <template class="DiceWindow" parent="AdwApplicationWindow">
    <property name="default-width">1180</property>
    <property name="default-height">760</property>
    <property name="width-request">720</property>
    <property name="height-request">540</property>
    <property name="title">Dice</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
      <object class="GtkBox" id="root_box">
        <property name="orientation">vertical</property>
        <style>
          <class name="root-bg"/>
        </style>

        <!-- Row 1 — thin titlebar / drag handle. The cover-size slider + menu
             sit opposite the window controls (_apply_titlebar_side). -->
        <child>
          <object class="GtkWindowHandle">
            <property name="height-request">48</property>
            <property name="child">
              <object class="GtkBox" id="titlebar_box">
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <property name="margin-start">16</property>
                <property name="margin-end">8</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkWindowControls" id="wc_start">
                    <property name="side">start</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScale" id="cover_scale">
                    <property name="orientation">horizontal</property>
                    <property name="draw-value">false</property>
                    <property name="width-request">120</property>
                    <property name="valign">center</property>
                    <property name="tooltip-text" translatable="yes">Cover size</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">120</property>
                        <property name="upper">260</property>
                        <property name="value">170</property>
                        <property name="step-increment">10</property>
                      </object>
                    </property>
                    <style>
                      <class name="thumb-scale"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="menu_button">
                    <property name="icon-name">dice-menu-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Main Menu</property>
                    <property name="valign">center</property>
                    <property name="menu-model">primary_menu</property>
                    <style>
                      <class name="flat"/>
                      <class name="circular"/>
                      <class name="titlebar-icon"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="titlebar_spacer">
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkWindowControls" id="wc_end">
                    <property name="side">end</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>

        <!-- Row 2 — navigation: platform tabs (built in code from the
             platform registry) or the search entry, then sort + search. -->
        <child>
          <object class="GtkBox" id="nav_row">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">16</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkStack" id="middle_stack">
                <property name="hexpand">true</property>
                <property name="valign">center</property>
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">100</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">view</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">external</property>
                        <property name="vscrollbar-policy">never</property>
                        <property name="propagate-natural-height">true</property>
                        <property name="child">
                          <object class="GtkBox" id="tabs_box">
                            <property name="orientation">horizontal</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="tab-group"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">search</property>
                    <property name="child">
                      <object class="GtkSearchEntry" id="search_entry">
                        <property name="placeholder-text" translatable="yes">Search titles, serials, regions</property>
                        <property name="hexpand">true</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="search-entry"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="sort_button">
                <property name="icon-name">dice-sort-symbolic</property>
                <property name="tooltip-text" translatable="yes">Sort</property>
                <property name="valign">center</property>
                <property name="menu-model">sort_menu</property>
                <style>
                  <class name="flat"/>
                  <class name="circular"/>
                  <class name="titlebar-icon"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="search_toggle_btn">
                <property name="tooltip-text" translatable="yes">Search</property>
                <property name="valign">center</property>
                <style>
                  <class name="flat"/>
                  <class name="circular"/>
                  <class name="titlebar-icon"/>
                </style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">system-search-symbolic</property>
                    <property name="pixel-size">14</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Content: the paper library card and the slide-in game panel -->
        <child>
          <object class="GtkBox" id="content_row">
            <property name="orientation">horizontal</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>

            <child>
              <object class="GtkStack" id="paper_stack">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">120</property>
                <style>
                  <class name="paper"/>
                </style>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">grid</property>
                    <property name="child">
                      <object class="GtkScrolledWindow" id="grid_scroller">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">true</property>
                        <property name="child">
                          <object class="DiceGridView" id="game_grid">
                            <property name="margin-top">24</property>
                            <property name="margin-bottom">24</property>
                            <property name="margin-start">24</property>
                            <property name="margin-end">24</property>
                            <property name="max-columns">4</property>
                            <property name="min-columns">4</property>
                            <style>
                              <class name="card-grid"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">empty</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="empty_page">
                        <property name="icon-name">io.github.drvonmiau.Dice-symbolic</property>
                        <property name="title" translatable="yes">No Games Yet</property>
                        <property name="description" translatable="yes">Add the folder where you keep your ROMs. Dice finds GBA, PSP and PS2 games inside it — sub-folders included — and never changes your files.</property>
                        <property name="child">
                          <object class="GtkButton" id="empty_add_btn">
                            <property name="label" translatable="yes">Add ROM Folder…</property>
                            <property name="halign">center</property>
                            <property name="action-name">win.add-folder</property>
                            <style>
                              <class name="pill"/>
                              <class name="empty-cta"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">none</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="none_page">
                        <property name="icon-name">system-search-symbolic</property>
                        <property name="title" translatable="yes">Nothing Here</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkRevealer" id="info_revealer">
                <!-- Explicit, so the panel's expanding labels can't pull extra
                     width away from the paper. -->
                <property name="hexpand">false</property>
                <property name="transition-type">slide-left</property>
                <property name="transition-duration">180</property>
                <property name="reveal-child">false</property>
                <property name="visible">false</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="info_scroller">
                    <property name="hscrollbar-policy">never</property>
                    <property name="propagate-natural-width">true</property>
                    <property name="min-content-width">300</property>
                    <property name="max-content-width">300</property>
                    <property name="child">
                      <object class="GtkBox" id="info_panel">
                        <property name="orientation">vertical</property>
                        <property name="spacing">16</property>
                        <property name="margin-bottom">24</property>
                        <style>
                          <class name="info-panel"/>
                        </style>
                        <child>
                          <object class="GtkOverlay">
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkBox" id="info_preview_slot">
                                <property name="orientation">vertical</property>
                              </object>
                            </child>
                            <child type="overlay">
                              <object class="GtkButton" id="info_close_btn">
                                <property name="icon-name">dice-x-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Close</property>
                                <property name="halign">end</property>
                                <property name="valign">start</property>
                                <property name="margin-top">10</property>
                                <property name="margin-end">10</property>
                                <style>
                                  <class name="info-close"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">4</property>
                            <child>
                              <object class="GtkLabel" id="info_title">
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="wrap-mode">word-char</property>
                                <property name="selectable">true</property>
                                <style>
                                  <class name="info-title"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="info_subtitle">
                                <property name="xalign">0</property>
                                <style>
                                  <class name="eyebrow"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">8</property>
                            <property name="homogeneous">false</property>
                            <child>
                              <object class="GtkButton" id="info_play_btn">
                                <property name="hexpand">true</property>
                                <property name="tooltip-text" translatable="yes">Play (Enter)</property>
                                <style>
                                  <class name="play-btn"/>
                                </style>
                                <child>
                                  <object class="AdwButtonContent">
                                    <property name="icon-name">dice-play-symbolic</property>
                                    <property name="label" translatable="yes">Play</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="info_fav_btn">
                                <property name="icon-name">dice-heart-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Add to Favourites</property>
                                <property name="width-request">48</property>
                                <style>
                                  <class name="info-action"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkMenuButton" id="info_more_btn">
                                <property name="icon-name">dice-more-symbolic</property>
                                <property name="tooltip-text" translatable="yes">More</property>
                                <property name="width-request">48</property>
                                <style>
                                  <class name="info-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="info_rows_box">
                            <property name="orientation">vertical</property>
                            <property name="spacing">10</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
        </property>
      </object>
    </property>
  </template>
</interface>
